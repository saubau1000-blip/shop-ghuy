local flyBV,flyBG,flyConn
local function startFly()
    local hrp=getHRP() if not hrp then return end
    flyBV=Instance.new("BodyVelocity",hrp) flyBV.MaxForce=Vector3.new(1e5,1e5,1e5) flyBV.Velocity=Vector3.zero
    flyBG=Instance.new("BodyGyro",hrp) flyBG.MaxTorque=Vector3.new(1e5,1e5,1e5) flyBG.P=1e4
    flyConn=R.RenderStepped:Connect(function()
        local cam=workspace.CurrentCamera local hrp=getHRP()
        if not hrp or not flyBV then return end
        local dir=Vector3.zero
        if U:IsKeyDown(Enum.KeyCode.W) then dir=dir+cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.S) then dir=dir-cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.A) then dir=dir-cam.CFrame.RightVector*-1 end
        if U:IsKeyDown(Enum.KeyCode.D) then dir=dir+cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
        if U:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir-Vector3.new(0,1,0) end
        if dir.Magnitude>0 then dir=dir.Unit end
        flyBV.Velocity=dir*50 flyBG.CFrame=cam.CFrame
    end)
end
local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn=nil end
    if flyBV then flyBV:Destroy() flyBV=nil end
    if flyBG then flyBG:Destroy() flyBG=nil end
end

local noclipConn
local function startNoclip()
    noclipConn=R.Stepped:Connect(function()
        local c=L.Character
        if c then for _,p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end end
    end)
end
local function stopNoclip()
    if noclipConn then noclipConn:Disconnect() noclipConn=nil end
    local c=L.Character
    if c then for _,p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=true end end end
end

